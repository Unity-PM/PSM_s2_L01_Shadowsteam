.respawn-overlay {
    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    background-color: rgba(0, 0, 0, 0.82);

    align-items: center;
    justify-content: center;

    flex-direction: column;
}

.death-title {
    font-size: 56px;

    color: #D64545;

    -unity-font-style: bold;

    margin-bottom: 18px;

    -unity-text-align: middle-center;
}

.respawn-timer {
    font-size: 20px;

    color: rgba(255,255,255,0.85);

    -unity-text-align: middle-center;
}