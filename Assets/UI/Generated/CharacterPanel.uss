/* Matches InventoryPanel / QuestJournalPanel */
.character-panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

.character-panel .inner-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 520px;
    height: 600px;
    background-color: rgba(15, 18, 35, 0.97);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(212, 175, 55, 0.3);
    border-right-color: rgba(212, 175, 55, 0.3);
    border-bottom-color: rgba(212, 175, 55, 0.3);
    border-left-color: rgba(212, 175, 55, 0.3);
    border-radius: 12px;
    flex-direction: column;
    padding: 24px;
}

.character-panel .header-label {
    color: #D4AF37;
    font-size: 20px;
    margin-bottom: 12px;
}

.character-panel .divider {
    height: 1px;
    background-color: rgba(212, 175, 55, 0.25);
    margin-bottom: 16px;
}

.stats-scroll {
    flex-grow: 1;
}

.stats-list {
    flex-direction: column;
}

.stat-section-label {
    color: #D4AF37;
    font-size: 13px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.03);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

.stat-row__name {
    color: rgba(255, 255, 255, 0.65);
    font-size: 13px;
    min-width: 120px;
}

.stat-row__value {
    color: rgba(255, 255, 255, 0.9);
    font-size: 13px;
    -unity-text-align: middle-right;
    flex-grow: 1;
}

.stat-row__value .stat-mod {
    color: #D4AF37;
}

.character-panel .close-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    border-width: 0;
    padding: 0;
}

.character-panel .close-btn:hover {
    background-color: rgba(212, 175, 55, 0.2);
    color: #D4AF37;
}

.character-panel .close-btn:active {
    background-color: rgba(212, 175, 55, 0.1);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.6);
}

.empty-hint {
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    margin-top: 8px;
}
