.crosshair-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    align-items: center;
    justify-content: center;

    picking-mode: ignore;
}

.crosshair {
    width: 18px;
    height: 18px;
    position: relative;
}

.crosshair__arm {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.92);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.88);
}

.crosshair__arm--top {
    width: 2px;
    height: 5px;
    left: 8px;
    top: 0;
}

.crosshair__arm--bottom {
    width: 2px;
    height: 5px;
    left: 8px;
    bottom: 0;
}

.crosshair__arm--left {
    width: 5px;
    height: 2px;
    left: 0;
    top: 8px;
}

.crosshair__arm--right {
    width: 5px;
    height: 2px;
    right: 0;
    top: 8px;
}

.crosshair__dot {
    position: absolute;
    width: 2px;
    height: 2px;
    left: 8px;
    top: 8px;
    background-color: rgba(255, 255, 255, 0.95);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.88);
}
