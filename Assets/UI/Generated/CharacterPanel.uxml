<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="CharacterPanel.uss" />

    <ui:VisualElement name="CharacterPanel" class="character-panel">
        <ui:VisualElement class="inner-panel">

            <ui:Label text="Character" class="header-label" />
            <ui:VisualElement class="divider" />

            <ui:ScrollView name="stats-scroll" class="stats-scroll" mode="Vertical">
                <ui:VisualElement name="stats-list" class="stats-list" />
            </ui:ScrollView>

            <ui:Button name="close-btn" text="✕" class="close-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
