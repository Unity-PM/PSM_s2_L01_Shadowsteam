.main-menu-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 320px;
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 12px;
    padding: 32px;
    flex-direction: column;
    align-items: stretch;
}

.header-label__text {
    font-size: 28px;
    color: #D4AF37;
    -unity-text-align: upper-center;
    margin-bottom: 24px;
}

.stat-bar {
    margin-bottom: 8px;
}

.gold-label {
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
    margin-top: 16px;
}