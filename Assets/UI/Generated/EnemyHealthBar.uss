.enemy-hp {

    position: absolute;

    width: 90px;
    height: 18px;
}

.enemy-hp__bg {

    width: 100%;
    height: 100%;

    background-color: rgba(0, 0, 0, 0.65);

    border-radius: 5px;

    overflow: hidden;

    align-items: center;
    justify-content: center;
}

.enemy-hp__fill {

    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    background-color: rgb(190, 40, 40);
}

.enemy-hp__text {

    width: 100%;
    height: 100%;

    color: white;

    font-size: 11px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}