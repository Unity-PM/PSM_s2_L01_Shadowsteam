.hud        { position: absolute; left: 16px; top: 16px; width: 220px; }
.stat-row   { flex-direction: row; align-items: center; margin-bottom: 6px; }
.stat-label { width: 28px; font-size: 12px; color: rgba(255,255,255,0.8); }

.bar-bg   { flex-grow: 1; height: 10px; background-color: rgba(0,0,0,0.5);
            border-radius: 5px; overflow: hidden; }

.bar-fill { height: 100%; width: 100%;
            transition-property: width;
            transition-duration: 0.15s; }

.bar-fill.hp      { background-color: #E85555; }
.bar-fill.mp      { background-color: #5588E8; }
.bar-fill.stamina { background-color: #55C855; }