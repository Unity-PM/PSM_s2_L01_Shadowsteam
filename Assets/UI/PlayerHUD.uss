.hud {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 220px;
}

.stat-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.stat-bar__label {
    width: 28px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.8);
}

.stat-bar__bg {
    flex-grow: 1;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 5px;
    overflow: hidden;
    position: relative;
    align-items: center;
    justify-content: center;
}

.stat-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.15s;
}

.stat-bar__value {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.9);
    -unity-font-style: bold;
}